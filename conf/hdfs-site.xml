<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<configuration>
    <!-- Default block replication factor (1 for single-node / pseudo-distributed) -->
    <property>
        <name>dfs.replication</name>
        <value>1</value>
        <description>Block replication count.</description>
    </property>

    <!-- NameNode metadata directory -->
    <property>
        <name>dfs.namenode.name.dir</name>
        <value>file://_HADOOP_NAMENODE_DIR_</value>
        <description>Path on local filesystem where NameNode stores the namespace and transactions.</description>
    </property>

    <!-- DataNode block storage directory -->
    <property>
        <name>dfs.datanode.data.dir</name>
        <value>file://_HADOOP_DATANODE_DIR_</value>
        <description>Path on local filesystem where DataNode stores blocks.</description>
    </property>

    <!-- NameNode Web UI Address -->
    <property>
        <name>dfs.namenode.http-address</name>
        <value>0.0.0.0:9870</value>
    </property>

    <!-- Disable permission checking for local development convenience -->
    <property>
        <name>dfs.permissions.enabled</name>
        <value>false</value>
    </property>
</configuration>
