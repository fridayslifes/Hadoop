<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<configuration>
    <!-- Execution framework set to Hadoop YARN -->
    <property>
        <name>mapreduce.framework.name</name>
        <value>yarn</value>
        <description>The runtime framework for executing MapReduce jobs.</description>
    </property>

    <!-- MapReduce ApplicationMaster container environment -->
    <property>
        <name>yarn.app.mapreduce.am.env</name>
        <value>HADOOP_MAPRED_HOME=${env.HADOOP_HOME},HADOOP_COMMON_HOME=${env.HADOOP_HOME},HADOOP_HDFS_HOME=${env.HADOOP_HOME},HADOOP_YARN_HOME=${env.HADOOP_HOME},HADOOP_HOME=${env.HADOOP_HOME}</value>
    </property>

    <!-- Map tasks container environment -->
    <property>
        <name>mapreduce.map.env</name>
        <value>HADOOP_MAPRED_HOME=${env.HADOOP_HOME},HADOOP_COMMON_HOME=${env.HADOOP_HOME},HADOOP_HDFS_HOME=${env.HADOOP_HOME},HADOOP_YARN_HOME=${env.HADOOP_HOME},HADOOP_HOME=${env.HADOOP_HOME}</value>
    </property>

    <!-- Reduce tasks container environment -->
    <property>
        <name>mapreduce.reduce.env</name>
        <value>HADOOP_MAPRED_HOME=${env.HADOOP_HOME},HADOOP_COMMON_HOME=${env.HADOOP_HOME},HADOOP_HDFS_HOME=${env.HADOOP_HOME},HADOOP_YARN_HOME=${env.HADOOP_HOME},HADOOP_HOME=${env.HADOOP_HOME}</value>
    </property>

    <!-- Memory configuration for local pseudo-distributed cluster -->
    <property>
        <name>mapreduce.map.memory.mb</name>
        <value>1024</value>
    </property>
    <property>
        <name>mapreduce.reduce.memory.mb</name>
        <value>1024</value>
    </property>

    <!-- MapReduce Application Classpath for Hadoop 3.x (resolves MRAppMaster ClassNotFoundException) -->
    <property>
        <name>mapreduce.application.classpath</name>
        <value>${env.HADOOP_HOME}/share/hadoop/mapreduce/*:${env.HADOOP_HOME}/share/hadoop/mapreduce/lib/*:${env.HADOOP_HOME}/share/hadoop/common/*:${env.HADOOP_HOME}/share/hadoop/common/lib/*:${env.HADOOP_HOME}/share/hadoop/hdfs/*:${env.HADOOP_HOME}/share/hadoop/hdfs/lib/*:${env.HADOOP_HOME}/share/hadoop/yarn/*:${env.HADOOP_HOME}/share/hadoop/yarn/lib/*</value>
    </property>
</configuration>
